# Copy these into the Render dashboard as environment variables.
PORT=10000

# Public URLs
BACKEND_URL=https://song-sakhi-auth1.onrender.com
FRONTEND_URL=https://song-sakhi.onrender.com

# Google (Web application OAuth client)
GOOGLE_CLIENT_ID=331023929615-ffl7jhc7s3oqspdl5nseifdql59b8u0h.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Spotify
SPOTIFY_CLIENT_ID=3a108eb4fbb846bcafe8c52c359098f6
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Gemini (song identification). Create at https://aistudio.google.com/apikey
# Keys start with "AIza". Never commit a real key to this repo.
GEMINI_API_KEY=AIza...
# Optional: force a specific model (defaults to the stable gemini-flash-latest alias)
# GEMINI_MODEL=gemini-2.5-flash

# Groq (free Whisper speech-to-text for lyrics). Create at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Optional: GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional: set to false to save Gemini quota (lyrics pipeline only)
# ENABLE_AUDIO_MODEL=true
